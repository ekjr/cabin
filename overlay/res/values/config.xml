<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and older. Tested pieces from an Android 11 Qualcomm tablet:
     the client profiles only start through these resources (props are ignored), and the
     call-integration service has its own switch. The headset (AG) role is left alone here
     and switched at runtime by cabin.sh through bluetooth_disabled_profiles. -->
<resources>
    <bool name="profile_supported_hfpclient">true</bool>
    <bool name="hfp_client_connection_service_enabled">true</bool>
    <bool name="profile_supported_pbapclient">true</bool>
    <bool name="profile_supported_mapmce">true</bool>
</resources>
